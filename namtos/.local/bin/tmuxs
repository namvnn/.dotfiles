#!/usr/bin/env bash

# Author: Nam Nguyen <nam.vnngu@gmail.com>
# Description: Create or switch to a tmux session
# License: MIT License
# Date Created: Jun 16, 2022
# Date Modified: November 04, 2026

if [[ "${#}" -eq "1" ]]; then
    directory="${1}"
else
    directory=$(find -L "${HOME}/Documents" "${HOME}/Development" -mindepth 1 -maxdepth 5 -type d 2>/dev/null | fzf)
fi

if [[ ! -d "${directory}" ]]; then
    echo "${directory}: No such directory"
    exit 1
fi

session_name=$(basename "${directory}" | tr . _)

if tmux has-session -t "${session_name}" 2>/dev/null; then
    if [[ -z "${TMUX}" ]]; then
        tmux attach-session -t "${session_name}"
    else
        tmux switch-client -t "${session_name}"
    fi
else
    if [[ -z "${TMUX}" ]]; then
        tmux new-session -s "${session_name}" -c "${directory}"
    else
        tmux new-session -ds "${session_name}" -c "${directory}"
        tmux switch-client -t "${session_name}"
    fi
fi
